diff --git a/src/ssh-generator/meson.build b/src/ssh-generator/meson.build
index f281a25184..a7162e9b86 100644
--- a/src/ssh-generator/meson.build
+++ b/src/ssh-generator/meson.build
@@ -3,15 +3,26 @@
