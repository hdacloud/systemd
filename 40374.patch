(cherry picked from commit d2d1fc59b4e7eae5eeb1e50c6ad42e8d5969daa2)
---
 src/basic/conf-files.c | 47 +++++++++++++++++++++++++++++++++++-------
 src/basic/conf-files.h | 13 ++++++------
 2 files changed, 46 insertions(+), 14 deletions(-)

diff --git a/src/basic/conf-files.c b/src/basic/conf-files.c
